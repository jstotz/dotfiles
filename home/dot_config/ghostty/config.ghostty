theme = Catppuccin Mocha
font-family = FiraCode Nerd Font
font-size = 12
window-padding-x = 8
window-padding-y = 8
window-save-state = always
macos-titlebar-style = transparent
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Only outer Ghostty terminals launch Herdr. Pane shells use normal Zsh startup.
command = /bin/zsh -l -c 'if command -v herdr >/dev/null 2>&1; then exec herdr; else exec /bin/zsh -l; fi'

# Native tab shortcuts target Herdr. \x00 is its Ctrl-Space prefix.
keybind = cmd+t=text:\x00c
keybind = cmd+w=text:\x00X
keybind = cmd+alt+w=text:\x00X
keybind = ctrl+tab=text:\x00n
keybind = ctrl+shift+tab=text:\x00p
keybind = cmd+shift+]=text:\x00n
keybind = cmd+shift+[=text:\x00p

# Override both physical and character digit bindings supplied by Ghostty.
keybind = cmd+digit_1=text:\x001
keybind = cmd+1=text:\x001
keybind = cmd+digit_2=text:\x002
keybind = cmd+2=text:\x002
keybind = cmd+digit_3=text:\x003
keybind = cmd+3=text:\x003
keybind = cmd+digit_4=text:\x004
keybind = cmd+4=text:\x004
keybind = cmd+digit_5=text:\x005
keybind = cmd+5=text:\x005
keybind = cmd+digit_6=text:\x006
keybind = cmd+6=text:\x006
keybind = cmd+digit_7=text:\x007
keybind = cmd+7=text:\x007
keybind = cmd+digit_8=text:\x008
keybind = cmd+8=text:\x008
# Herdr selects tab 9 here, unlike Ghostty's native last-tab action.
keybind = cmd+9=text:\x009

mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
